# Cloudflare Tunnel serves the public DOMAIN through the app's loopback port.
# Caddy retains the previous direct hostname and IP for health checks and redirects.
{
	default_sni {$PUBLIC_IP}
}

https://{$DIRECT_DOMAIN} {
	tls {
		issuer acme {
			dir {$ACME_CA}
		}
	}
	handle /api/health {
		reverse_proxy app:3000
	}
	handle {
		redir https://{$DOMAIN}{uri} 302
	}
}

https://{$PUBLIC_IP} {
	tls {
		issuer acme {
			dir {$ACME_CA}
			profile shortlived
		}
	}
	handle /api/health {
		reverse_proxy app:3000
	}
	handle {
		redir https://{$DOMAIN}{uri} 302
	}
}
